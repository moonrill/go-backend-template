APP_NAME=go-backend-template
APP_ENV=development
APP_PORT=8080
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=15s
APP_IDLE_TIMEOUT=60s
APP_SHUTDOWN_TIMEOUT=15s
# Comma-separated list of trusted proxy IPs or CIDRs (empty = trust no proxies).
APP_TRUSTED_PROXIES=

# PostgreSQL is optional. When enabled, DATABASE_URL is required.
DATABASE_ENABLED=false
DATABASE_URL=
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1
DATABASE_CONNECT_TIMEOUT=3s
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m
DATABASE_HEALTH_CHECK_PERIOD=1m

# Redis is optional. Reserved for the Redis integration phase.
REDIS_ENABLED=false
REDIS_URL=
REDIS_CONNECT_TIMEOUT=2s

# S3-compatible object storage / MinIO is optional.
MINIO_ENABLED=false
MINIO_ENDPOINT=
MINIO_REGION=us-east-1
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=true

# Observability modules can be toggled independently.
METRICS_ENABLED=true
TRACING_ENABLED=false
LOG_LEVEL=info
