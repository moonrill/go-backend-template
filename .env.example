APP_NAME=go-backend-template
APP_ENV=development
APP_PORT=8080
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=15s
APP_IDLE_TIMEOUT=60s
APP_SHUTDOWN_TIMEOUT=15s
# Comma-separated list of trusted proxy IPs or CIDRs (empty = trust no proxies).
APP_TRUSTED_PROXIES=

# PostgreSQL is optional. When enabled, DATABASE_URL is required.
DATABASE_ENABLED=false
DATABASE_URL=
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1
DATABASE_CONNECT_TIMEOUT=3s
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m
DATABASE_HEALTH_CHECK_PERIOD=1m

# Redis is optional. When enabled, REDIS_URL is required.
# Deployment contexts:
# - Host machine (go run): redis://127.0.0.1:6379/0
# - Docker Compose:        redis://redis:6379/0
# - Kubernetes:            redis://<service-name>.<namespace>.svc.cluster.local:6379/0
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# S3-compatible object storage / MinIO is optional. When enabled, ENDPOINT, BUCKET, ACCESS_KEY, and SECRET_KEY are required.
# Deployment contexts:
# - Host machine (go run): 127.0.0.1:9000
# - Docker Compose:        minio:9000
# - Kubernetes:            minio-service.default.svc.cluster.local:9000
MINIO_ENABLED=false
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=app-bucket
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_CONNECT_TIMEOUT=5s
MINIO_AUTO_CREATE_BUCKET=true

# Observability
METRICS_ENABLED=true
LOG_LEVEL=info

# Grafana Monitoring Stack (compose.yaml --profile monitoring)
# Local development port is bound strictly to loopback (127.0.0.1:3000).
# Anonymous authentication is disabled; an explicit strong administrator password is required.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-a-secure-password

# OpenTelemetry Distributed Tracing
TRACING_ENABLED=false
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=go-backend-template
# Protocol: grpc (default) or http/protobuf
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Endpoints:
# - Docker Compose (via Alloy): http://alloy:4318 (HTTP) or alloy:4317 (gRPC)
# - Docker Compose (direct Tempo): http://tempo:4318 or tempo:4317
# - Host machine:               http://localhost:4318 or localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# Sampler: parentbased_traceidratio, parentbased_always_on, always_on, always_off, traceidratio
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
