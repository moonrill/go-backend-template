APP_NAME=go-backend-template
APP_ENV=development
APP_PORT=8080
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=15s
APP_IDLE_TIMEOUT=60s
APP_SHUTDOWN_TIMEOUT=15s
# Comma-separated list of trusted proxy IPs or CIDRs (empty = trust no proxies).
APP_TRUSTED_PROXIES=

# PostgreSQL is optional. When enabled, DATABASE_URL is required.
DATABASE_ENABLED=false
DATABASE_URL=
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1
DATABASE_CONNECT_TIMEOUT=3s
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m
DATABASE_HEALTH_CHECK_PERIOD=1m

# Redis is optional. When enabled, REDIS_URL is required.
# Deployment contexts:
# - Host machine (go run): redis://127.0.0.1:6379/0
# - Docker Compose:        redis://redis:6379/0
# - Kubernetes:            redis://<service-name>.<namespace>.svc.cluster.local:6379/0
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# S3-compatible object storage / MinIO is optional. When enabled, ENDPOINT, BUCKET, ACCESS_KEY, and SECRET_KEY are required.
# Deployment contexts:
# - Host machine (go run): 127.0.0.1:9000
# - Docker Compose:        minio:9000
# - Kubernetes:            minio-service.default.svc.cluster.local:9000
MINIO_ENABLED=false
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=app-bucket
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_CONNECT_TIMEOUT=5s
MINIO_AUTO_CREATE_BUCKET=true

# Observability modules can be toggled independently.
METRICS_ENABLED=true
TRACING_ENABLED=false
LOG_LEVEL=info
